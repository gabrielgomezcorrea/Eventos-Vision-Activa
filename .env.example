APP_NAME="Eventos VisionActiva"
# Producción: APP_ENV=production, APP_DEBUG=false y APP_URL con https://.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Santiago

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Producción: true, para que la cookie de sesión viaje solo por HTTPS.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Producción: la misma cuenta de Gmail de MAIL_USERNAME. Gmail reescribe el remitente si no coincide.
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Cuenta correos gmail
# Para usarla: descomentar estas líneas y comentar MAIL_HOST, MAIL_PORT, MAIL_USERNAME, MAIL_PASSWORD y MAIL_FROM_ADDRESS de arriba.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FILESYSTEM_PRIVATE_DISK=documentos

# Sitios que pueden mostrar el formulario público dentro de un iframe (landing WordPress, etc.).
# - Dominio exacto con https://, sin / final ni rutas. Separados por coma, sin espacios.
# - Si el sitio se abre con y sin www, poner los dos.
# - Vacío: ningún sitio puede embeberlo (el iframe queda en blanco).
# Ejemplos:
#   EMBED_ALLOWED_ORIGINS=https://milanding.cl
#   EMBED_ALLOWED_ORIGINS=https://milanding.cl,https://www.milanding.cl,https://visionactiva.cl
# Después de cambiarlo:
#   Local:      reiniciar `composer run dev` (o `php artisan config:clear`).
#   Producción: `php artisan config:cache`.
EMBED_ALLOWED_ORIGINS=

# Copia de cada factura enviada al cliente, para trazabilidad de administración.
FACTURACION_COPIA_ADMINISTRACION=
