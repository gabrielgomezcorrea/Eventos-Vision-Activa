includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    exceptions:
        # Database errors are thrown at runtime (foreign keys, unique indexes): a catch for them is not dead code.
        uncheckedExceptionClasses:
            - Illuminate\Database\QueryException
        reportUncheckedExceptionDeadCatch: false
